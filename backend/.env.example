# Copy to backend/.env for local development. Defaults match compose.dev.yaml.
DOCQA_ENVIRONMENT=dev
DOCQA_DATABASE_URL=postgresql+asyncpg://docqa:docqa@localhost:55432/docqa
DOCQA_VALKEY_URL=valkey://localhost:56379/0
DOCQA_QDRANT_URL=http://localhost:56333

# Auth. In prod DOCQA_JWT_SECRET is required (32+ characters).
# Sign-up stays closed until DOCQA_INVITE_CODE is set.
# Uncomment and fill in; an empty secret is rejected at startup.
# DOCQA_JWT_SECRET=
# DOCQA_INVITE_CODE=
# Behind the Runpod proxy set this to CF-Connecting-IP so rate limits see real client IPs.
# DOCQA_CLIENT_IP_HEADER=
