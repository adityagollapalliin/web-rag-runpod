# Copy to backend/.env for local development. Defaults match compose.dev.yaml.
DOCQA_ENVIRONMENT=dev
DOCQA_DATABASE_URL=postgresql+asyncpg://docqa:docqa@localhost:55432/docqa
DOCQA_VALKEY_URL=valkey://localhost:56379/0
DOCQA_QDRANT_URL=http://localhost:56333

# Auth. In prod DOCQA_JWT_SECRET is required (32+ characters).
# Sign-up stays closed until DOCQA_INVITE_CODE is set.
# Uncomment and fill in; an empty secret is rejected at startup.
# DOCQA_JWT_SECRET=
# DOCQA_INVITE_CODE=
# Behind the Runpod proxy set this to CF-Connecting-IP so rate limits see real client IPs.
# DOCQA_CLIENT_IP_HEADER=

# Documents and ingestion
# DOCQA_STORAGE_DIR=var/uploads
# DOCQA_CELERY_BROKER_URL=redis://localhost:56379/1
# DOCQA_EMBEDDING_PROVIDER=fake          # fake | openai (vLLM)
# DOCQA_EMBEDDING_URL=http://127.0.0.1:8002
# DOCQA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# DOCQA_EMBEDDING_DIMENSION=1024

# Answering. Providers default to fakes; prod requires real ones.
# DOCQA_EMBEDDING_QUERY_PREFIX=
# DOCQA_RERANK_PROVIDER=fake             # fake | http (vLLM /v1/rerank)
# DOCQA_RERANK_URL=http://127.0.0.1:8003
# DOCQA_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# DOCQA_CHAT_PROVIDER=fake               # fake | openai (vLLM)
# DOCQA_CHAT_URL=http://127.0.0.1:8001
# DOCQA_CHAT_MODEL=

# Built web app to serve from the API (unset in development, where Vite serves it).
# DOCQA_STATIC_DIR=../frontend/dist
